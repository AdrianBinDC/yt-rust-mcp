# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# The binary loads .env if present (does not override vars already in the environment).

# YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials)
# Enable "YouTube Data API v3" on the project first.
YOUTUBE_API_KEY=

# Logging is off-by-default quiet (warn). Metadata-only debug (no keys, bodies, or queries):
# RUST_LOG=yt_rust_mcp=debug

# Experimental transcript tool (off by default). Only `1` or `true` enables it.
# When off, tools/list and server instructions omit youtube_transcript.
# ENABLE_MCP_TRANSCRIPT=1

# non_search counter: videos, channels, playlists, playlist items. Unset uses 10000.
# YOUTUBE_NON_SEARCH_BUDGET=10000

# search counter: search.list only. Unset uses 100.
# YOUTUBE_SEARCH_BUDGET=100

# SQLite file directory. Unset uses the platform cache dir / yt-rust-mcp.
# YT_RUST_MCP_CACHE_DIR=

# Config and prompt files. Unset uses ./config/default.toml and ./prompts.
# YT_RUST_MCP_CONFIG=
# YT_RUST_MCP_PROMPTS=
