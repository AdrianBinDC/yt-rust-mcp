# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials)
# Enable "YouTube Data API v3" on the project first.
YOUTUBE_API_KEY=

# Local daily unit budget for soft limiting. Unset uses 10000.
# YOUTUBE_QUOTA_BUDGET=10000

# Local daily budget for search.list calls (scarce bucket). Unset uses 100.
# YOUTUBE_SEARCH_BUDGET=100
